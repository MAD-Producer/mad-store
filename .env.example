# 公开站点地址（不要带末尾斜杠）
NEXT_PUBLIC_SITE_URL=https://store.madproducer.cn

# MongoDB Atlas M0
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mad_store

# 多管理员账号，使用 JSON 数组；请为每个账号设置独立的长随机密码
ADMIN_ACCOUNTS=[{"username":"admin-a","password":"change-me-a"},{"username":"admin-b","password":"change-me-b"}]
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# 兼容旧版单管理员配置；使用 ADMIN_ACCOUNTS 时无需填写
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMTP 邮件提醒
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=change-me
SMTP_FROM=MAD Store <mailer@example.com>
# 多个收件人使用英文逗号分隔
ADMIN_EMAILS=admin-a@example.com,admin-b@example.com

# DeepSeek 智能初审（可选，不配置时仍可正常提交并人工审核）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# GitHub API（可选，提高公开仓库 README 的读取限额）
GITHUB_TOKEN=
